{
  "name": "traqiva-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "wrangler dev --local --port 8789 --assets public",
    "build": "node scripts/collect-notices.mjs && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "lint": "eslint src server tests --max-warnings 0",
    "test": "vitest run",
    "test:cli": "node --test cli/tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote --config wrangler.self-host.jsonc",
    "deploy": "node scripts/self-host.mjs",
    "pack:cli": "node scripts/pack-cli.mjs",
    "self-host": "node scripts/self-host.mjs",
    "test:self-host": "node --test scripts/tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "license": "Apache-2.0"
}
