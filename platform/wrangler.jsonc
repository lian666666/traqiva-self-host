{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "traqiva-self-host",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/v1/*",
      "/health"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "traqiva-self-host-db",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  }
}
